---
// Clean Astro Frontmatter Block
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>tythao.dev ✦ Developer Hub & Portfolio</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;800&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest" type="module"></script>

  <style>
    :root {
      --bg-clean: #ffffff;
      --card-bg: #f8f9fc;
      --text-dark: #0f172a;
      --text-muted: #475569;
      --border-color: #0f172a;
      
      --pop-red: #e11d48;
      --pop-yellow: #ffe600;
      --pop-cyan: #00f0ff;
      --pop-purple: #8b5cf6;

      --font-loud: 'Space Grotesk', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;

      --border-bold: 3px solid var(--border-color);
      --shadow-pop: 5px 5px 0px var(--border-color);
    }

    html.dark-mode {
      --bg-clean: #0b0f19;
      --card-bg: #161f32;
      --text-dark: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: #f8fafc;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-clean);
      color: var(--text-dark);
      font-family: var(--font-body);
      font-weight: 400;
      line-height: 1.6;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .announcement-bar {
      background: var(--pop-yellow);
      color: #0f172a;
      border-bottom: var(--border-bold);
      font-family: var(--font-loud);
      font-size: 0.85rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      text-align: center;
      padding: 10px 20px;
    }

    header {
      border-bottom: var(--border-bold);
      padding: 24px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-clean);
      transition: background-color 0.3s ease;
    }

    .logo {
      font-family: var(--font-loud);
      font-size: 2.2rem;
      font-weight: 900;
      text-decoration: none;
      color: var(--text-dark);
      text-transform: uppercase;
    }

    .logo span {
      color: #fff;
      background: var(--pop-red);
      padding: 0 8px;
      border: var(--border-bold);
      box-shadow: 3px 3px 0px var(--border-color);
      transform: rotate(-2deg);
      display: inline-block;
    }

    .nav-links {
      display: flex;
      gap: 32px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text-dark);
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.9rem;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--pop-red); }

    .nav-actions {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .theme-toggle-btn {
      position: relative;
      background: var(--card-bg);
      color: var(--text-dark);
      border: var(--border-bold);
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 3px 3px 0px var(--border-color);
      transition: transform 0.2s;
    }
    .theme-toggle-btn svg {
      position: absolute;
      inset: 0;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .theme-toggle-btn .theme-icon-fallback { font-size: 18px; line-height: 1; }
    /* Show exactly one icon: hide the emoji fallback as soon as Lucide inserts an <svg>,
       so they never stack on top of each other. */
    .theme-toggle-btn:has(svg) .theme-icon-fallback { display: none; }
    .theme-toggle-btn:hover { transform: scale(1.1) rotate(15deg); background: var(--pop-cyan); color: #0f172a; }

    .hero {
      position: relative;
      height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 8%;
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(15, 23, 42, 0.85) 100%),
                  url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=2000&q=80') center/cover no-repeat;
      color: #fff;
      text-align: center;
      border-bottom: var(--border-bold);
    }

    .hero-content { max-width: 900px; }

    .hero-sub {
      font-family: var(--font-loud);
      font-size: 0.85rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 20px;
      background: var(--pop-red);
      color: #fff;
      padding: 4px 16px;
      display: inline-block;
      border: 2px solid var(--border-color);
      box-shadow: 3px 3px 0px var(--border-color);
      transform: rotate(-1deg);
    }

    .hero h1 {
      font-family: var(--font-loud);
      font-size: clamp(38px, 5.5vw, 76px);
      line-height: 1.15;
      margin-bottom: 30px;
      font-weight: 900;
      text-transform: uppercase;
    }

    .hero h1 span { color: var(--pop-yellow); }

    .btn-brutal {
      display: inline-block;
      padding: 16px 40px;
      background: var(--pop-yellow);
      color: #0f172a;
      border: var(--border-bold);
      text-decoration: none;
      font-family: var(--font-loud);
      font-size: 1rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      box-shadow: var(--shadow-pop);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-brutal:hover {
      transform: translate(-3px, -3px);
      box-shadow: 8px 8px 0px var(--pop-red);
      background: var(--pop-cyan);
    }

    /* PROJECTS SECTION */
    .section-header {
      padding: 80px 8% 30px 8%;
      border-bottom: var(--border-bold);
      background: var(--card-bg);
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      transition: background-color 0.3s ease;
    }

    .section-title {
      font-family: var(--font-loud);
      font-size: clamp(28px, 3.5vw, 44px);
      font-weight: 900;
      text-transform: uppercase;
      letter-spacing: -0.5px;
    }

    /* CAROUSEL WRAPPER WITH ABSOLUTE ARROWS ON LEFT & RIGHT SIDES */
    .carousel-section-container {
      position: relative;
      background: var(--bg-clean);
      border-bottom: var(--border-bold);
      padding: 80px 10%;
      transition: background-color 0.3s ease;
    }

    .carousel-track-container {
      overflow-x: hidden;
      scroll-behavior: smooth;
      width: 100%;
    }

    .carousel-track {
      display: flex;
      gap: 30px;
      transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .showcase-card {
      min-width: 360px;
      flex: 0 0 360px;
      background: var(--bg-clean);
      border: var(--border-bold);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: var(--shadow-pop);
      text-decoration: none;
      color: var(--text-dark);
      display: flex;
      flex-direction: column;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .card-img-wrap {
      height: 260px;
      border-bottom: var(--border-bold);
      overflow: hidden;
      position: relative;
      background: var(--card-bg);
    }

    .card-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .card-tag {
      position: absolute;
      top: 16px;
      left: 16px;
      background: var(--pop-yellow);
      color: #0f172a;
      font-family: var(--font-loud);
      font-size: 0.75rem;
      font-weight: 900;
      padding: 4px 12px;
      border: 2px solid var(--border-color);
      border-radius: 20px;
      box-shadow: 2px 2px 0px var(--border-color);
    }

    .card-body {
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex-grow: 1;
      justify-content: space-between;
    }

    .card-title {
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 1.3rem;
      color: var(--text-dark);
    }

    .card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 14px;
      font-family: var(--font-body);
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-dark);
    }

    /* CAROUSEL SIDE ARROWS */
    .side-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: var(--pop-yellow);
      border: var(--border-bold);
      width: 54px;
      height: 54px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--shadow-pop);
      transition: all 0.2s ease;
      color: var(--text-dark);
      z-index: 10;
    }

    .side-arrow:hover {
      background: var(--pop-cyan);
      transform: translateY(-50%) scale(1.1);
      box-shadow: 7px 7px 0px var(--border-color);
    }

    .arrow-left { left: 20px; }
    .arrow-right { right: 20px; }

    /* Fallback arrow glyphs: visible until Lucide inserts an <svg> before the <i>. */
    .side-arrow .arrow-fallback,
    .side-arrow svg {
      position: absolute;
      inset: 0;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .side-arrow .arrow-fallback { font-size: 24px; line-height: 1; }
    .side-arrow svg + i + .arrow-fallback,
    .side-arrow svg ~ .arrow-fallback { display: none; }

    .feature-row {
      display: flex;
      align-items: center;
      border-bottom: var(--border-bold);
      background: var(--card-bg);
      transition: background-color 0.3s ease;
    }

    .feature-row.reverse {
      flex-direction: row-reverse;
      background: var(--bg-clean);
    }

    .feature-text {
      flex: 1;
      padding: 80px 8%;
    }

    .feature-text h2 {
      font-family: var(--font-loud);
      font-size: clamp(32px, 4vw, 48px);
      font-weight: 900;
      text-transform: uppercase;
      line-height: 1.15;
      margin-bottom: 24px;
    }

    .feature-text p {
      font-size: 1.05rem;
      color: var(--text-muted);
      line-height: 1.8;
      margin-bottom: 30px;
      font-family: var(--font-body);
    }

    .feature-media {
      flex: 1;
      height: 500px;
      border-left: var(--border-bold);
      overflow: hidden;
    }

    .feature-row.reverse .feature-media {
      border-left: none;
      border-right: var(--border-bold);
    }

    .feature-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    footer {
      background: var(--card-bg);
      border-top: var(--border-bold);
      padding: 80px 8% 40px 8%;
      text-align: center;
      font-family: var(--font-body);
      font-weight: 600;
      transition: background-color 0.3s ease;
    }

    .footer-brand {
      font-family: var(--font-loud);
      font-size: 2.2rem;
      font-weight: 900;
      margin-bottom: 16px;
      text-transform: uppercase;
    }

    @media (max-width: 900px) {
      .feature-row, .feature-row.reverse { flex-direction: column; }
      .feature-media { width: 100%; border-left: none; border-top: var(--border-bold); }
      .nav-links { display: none; }
      .side-arrow { width: 40px; height: 40px; }
      .arrow-left { left: 5px; }
      .arrow-right { right: 5px; }
    }
  </style>

  <!-- Script to apply dark mode class instantly on HTML root to prevent flash -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('theme') || 'light';
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark-mode');
      }
    } catch (e) { /* ignore storage errors on first load */ }
  </script>
</head>
<body>

  <div class="announcement-bar">
    ✦ PORTFOLIO PROJECTS ✦
  </div>

  <header>
    <a href="#about" class="logo">TYTHAO</a>
    
    <ul class="nav-links">
      <li><a href="#about">About Me</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>

    <div class="nav-actions">
      <button class="theme-toggle-btn" id="themeToggle" title="Toggle Theme">
        <span class="theme-icon-fallback" aria-hidden="true">🌙</span>
        <i data-lucide="moon" id="themeIcon"></i>
      </button>
      <button type="button" class="btn-brutal" style="padding: 10px 20px; font-size: 0.85rem;">Launch App ↗</button>
    </div>
  </header>

  <section class="hero" id="about">
    <div class="hero-content">
      <span class="hero-sub">AI EXPLORER</span>
      <h1>EXPLORING <br><span>AI</span></h1>
      <button type="button" class="btn-brutal" id="exploreHubBtn">Explore The Hub</button>
    </div>
  </section>

  <!-- PROJECTS SECTION HEADER -->
  <div class="section-header" id="projects">
    <div>
      <span style="font-family: var(--font-loud); font-size: 0.8rem; background: var(--pop-cyan); padding: 4px 12px; border: 2px solid var(--border-color); border-radius: 20px; font-weight: 800;">PORTFOLIO FEED</span>
      <h2 class="section-title" style="margin-top: 10px;">PROJECTS</h2>
    </div>
  </div>

  <!-- CAROUSEL WRAPPER WITH < > SIDE ARROWS -->
  <div class="carousel-section-container">
    <button class="side-arrow arrow-left" id="prevBtn" aria-label="Previous Project">
      <span class="arrow-fallback" aria-hidden="true">◀</span>
      <i data-lucide="chevron-left" size="32"></i>
    </button>
    <button class="side-arrow arrow-right" id="nextBtn" aria-label="Next Project">
      <span class="arrow-fallback" aria-hidden="true">▶</span>
      <i data-lucide="chevron-right" size="32"></i>
    </button>

    <div class="carousel-track-container" id="carouselContainer">
      <div class="carousel-track" id="carouselTrack">
        
        <!-- Project 1: To Do List -->
        <a href="/todo" class="showcase-card">
          <div class="card-img-wrap">
            <span class="card-tag">RUNNING LIVE</span>
            <img src="https://images.unsplash.com/photo-1540350394557-8d14678e7f91?auto=format&fit=crop&w=800&q=80" alt="To Do List Checkmark">
          </div>
          <div class="card-body">
            <div>
              <span style="font-size: 0.75rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Project 1</span>
              <h3 class="card-title">To Do List</h3>
            </div>
            <div class="card-meta">
              <span>Orchestration + Multi-Agents</span>
              <span style="color: var(--pop-red);">Launch &nearr;</span>
            </div>
          </div>
        </a>

        <!-- Project 2: TBD -->
        <div class="showcase-card">
          <div class="card-img-wrap">
            <span class="card-tag">TBD</span>
            <img src="https://images.unsplash.com/photo-1454496522488-7a8e488e8606?auto=format&fit=crop&w=800&q=80" alt="Placeholder Mountain">
          </div>
          <div class="card-body">
            <div>
              <span style="font-size: 0.75rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Project 2</span>
              <h3 class="card-title">TBD</h3>
            </div>
            <div class="card-meta">
              <span style="color: var(--text-muted); font-style: italic;">Coming soon</span>
            </div>
          </div>
        </div>

        <!-- Project 3: TBD -->
        <div class="showcase-card">
          <div class="card-img-wrap">
            <span class="card-tag">TBD</span>
            <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80" alt="Placeholder Nature">
          </div>
          <div class="card-body">
            <div>
              <span style="font-size: 0.75rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Project 3</span>
              <h3 class="card-title">TBD</h3>
            </div>
            <div class="card-meta">
              <span style="color: var(--text-muted); font-style: italic;">Coming soon</span>
            </div>
          </div>
        </div>

        <!-- Project 4: TBD -->
        <div class="showcase-card">
          <div class="card-img-wrap">
            <span class="card-tag">TBD</span>
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=800&q=80" alt="Placeholder Scenery">
          </div>
          <div class="card-body">
            <div>
              <span style="font-size: 0.75rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Project 4</span>
              <h3 class="card-title">TBD</h3>
            </div>
            <div class="card-meta">
              <span style="color: var(--text-muted); font-style: italic;">Coming soon</span>
            </div>
          </div>
        </div>

        <!-- Project 5: TBD -->
        <div class="showcase-card">
          <div class="card-img-wrap">
            <span class="card-tag">TBD</span>
            <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=800&q=80" alt="Placeholder Night Sky">
          </div>
          <div class="card-body">
            <div>
              <span style="font-size: 0.75rem; font-family: var(--font-body); font-weight: 800; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Project 5</span>
              <h3 class="card-title">TBD</h3>
            </div>
            <div class="card-meta">
              <span style="color: var(--text-muted); font-style: italic;">Coming soon</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <section class="feature-row" id="capabilities">
    <div class="feature-text">
      <h2 style="margin-top: 15px;">HYBRID AI <br><span style="color: var(--pop-red);">PROJECTS</span></h2>
      <p>A hybrid approach: local models build a majority of the project while frontier models assist when necessary.</p>
      <button type="button" class="btn-brutal">Explore Environment</button>
    </div>
    <div class="feature-media">
      <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1000&q=80" alt="Nature Scenery">
    </div>
  </section>

  <section class="feature-row reverse">
    <div class="feature-text">
      <h2 style="margin-top: 15px;">System Architecture <br><span style="color: var(--pop-red);">Workflow Design</span></h2>
      <p>Operating as a system architech, I simply plan, build, test, and then ship. If the project is more complex, I expand and change the workflow as needed.</p>
      <button type="button" class="btn-brutal">Explore Pipeline</button>
    </div>
    <div class="feature-media">
      <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1000&q=80" alt="Mountain Landscape">
    </div>
  </section>

  <!-- CONTACT / FOOTER SECTION -->
  <footer id="contact">
    <div class="footer-brand">TYTHAO</div>
    <p style="font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">&copy; 2026 TYTHAO &bull; ALL RIGHTS RESERVED.</p>
  </footer>

  <script>
    // Lucide (CDN) is optional: if it fails to load, the page must still work
    // — fallback glyph icons handle arrows and the theme toggle.
    const renderIcons = () => { try { window.lucide?.createIcons(); } catch (e) {} };
    renderIcons();
    // The Lucide CDN module may finish loading after this inline script runs, so re-render
    // once on load to make sure the icons (and the fallback-hiding rule) take effect.
    window.addEventListener('load', renderIcons);

    // Smooth-scroll to #projects
    const exploreHubBtn = document.getElementById('exploreHubBtn');
    if (exploreHubBtn) {
      exploreHubBtn.addEventListener('click', () => {
        const target = document.getElementById('projects');
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // Functional Carousel Slider Logic
    const container = document.getElementById('carouselContainer');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    if (container && prevBtn && nextBtn) {
      const scrollAmount = 390; // card width (360px) + gap (30px)

      nextBtn.addEventListener('click', () => {
        container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });

      prevBtn.addEventListener('click', () => {
        container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }

    // Theme Toggle — works with or without Lucide
    const themeToggle = document.getElementById('themeToggle');
    const themeIcon = document.getElementById('themeIcon');
    const themeFallback = document.querySelector('.theme-toggle-btn .theme-icon-fallback');

    const setThemeGlyph = (isDark) => {
      // Update the Lucide icon (if present)
      if (themeIcon) themeIcon.setAttribute('data-lucide', isDark ? 'sun' : 'moon');
      // Update the text fallback so it's always correct
      if (themeFallback) themeFallback.textContent = isDark ? '☀' : '🌙';
      renderIcons();
    };

    // Initialize glyph to match current state
    setThemeGlyph(document.documentElement.classList.contains('dark-mode'));

    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        document.documentElement.classList.toggle('dark-mode');
        const isDark = document.documentElement.classList.contains('dark-mode');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
        setThemeGlyph(isDark);
      });
    }
  </script>
</body>
</html>
