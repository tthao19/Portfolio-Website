---
import '../styles/todo.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="A standalone neo-brutalist Todo app. Pure vanilla JS, zero runtime dependencies, persisted to LocalStorage."
    />
    <title>Todo — Standalone Astro + Vanilla JS + LocalStorage</title>
  </head>
  <body>
    <!-- Markup lane fragment: standalone HTML5 fragment, inlined into an Astro page at build time. -->
      <nav class="todo-nav">
        <a href="/" class="todo-nav__link todo-nav__link--active">HOME</a>
        <button type="button" class="todo-nav__link todo-info-toggle" id="todoInfoToggle" aria-expanded="false" aria-controls="todoInfoPanel">INFO</button>
      </nav>

    <div id="todo-workspace" class="todo-workspace">
      <!-- Info panel: sits ABOVE the todo (normal flow) and pushes the list down when open.
           Collapsed by default so the todo stays first. -->
      <aside id="todoInfoPanel" class="todo-info" aria-label="How this app was built">
        <header class="todo-info__head">
          <span class="todo-info__badge">HOW IT'S BUILT</span>
          <h2 class="todo-info__title">Multi&#8209;agent pipeline</h2>
        </header>

        <p class="todo-info__lead">
          Three AI agents worked <strong>concurrently</strong> on their own git branches and
          never touched the same line. An orchestrator managed the project and agents with
          <strong>zero</strong> merge conflicts.
        </p>

        <pre class="todo-info__graph" aria-label="Git commit graph">* 34d8f0e feat(page): integrate fragment + styles + client wiring
*   7d91c0a merge: feature/styles    (agent 3)
|\
| * 2f2f918 feat(styles): stylesheet + client wiring
* |   10c9803 merge: feature/logic   (agent 2)
| \
| * | eb2c1b7 feat(logic): state + LocalStorage
* |   82e3043 merge: feature/markup  (agent 1)
|/|
| * e95f7a7 feat(markup): todo.html fragment
|/
* deaca8b chore: initialize Astro scaffold</pre>

        <ul class="todo-info__agents" aria-label="Agent lanes">
          <li><strong>Agent 1 · markup</strong> → <code>todo.html</code> (form, list, counter)</li>
          <li><strong>Agent 2 · logic</strong> → <code>todo.js</code> + <code>todo-client.js</code> (state + LocalStorage)</li>
          <li><strong>Agent 3 · styles</strong> → <code>todo.css</code> (neo-brutalist theme)</li>
          <li><strong>Orchestrator</strong> → scaffold, spawn, merge &amp; integrate <code>index.astro</code></li>
        </ul>
      </aside>

      <section id="todo-app" aria-label="Todo application">
      <header class="todo-header">
        <h1 class="todo-title">Todo.</h1>
      </header>

      <form id="task-form" class="task-form" autocomplete="off" aria-label="Add a task">
        <input
          type="text"
          id="task-input"
          name="task"
          class="task-input"
          placeholder="What needs to get done?"
          maxlength="200"
          required
          aria-label="New task description"
        />
        <button type="submit" class="task-add">Add task</button>
      </form>

      <!-- Task items are rendered here by the client script. -->
      <ul id="task-list" class="task-list"></ul>

      <p id="task-counter" class="task-counter">0 tasks remaining</p>
    </section>
    </div>

    <script>
      import { initTodoApp } from '../lib/todo-client.js';
      initTodoApp();

      // ---- INFO panel: expands in-flow ABOVE the todo (pushes the list down) ----
      const infoPanel  = document.getElementById('todoInfoPanel');
      const infoToggle = document.getElementById('todoInfoToggle');

      // Start CLOSED (todo-first).
      infoPanel.classList.remove('is-open');
      infoToggle.setAttribute('aria-expanded', 'false');

      infoToggle.addEventListener('click', () => {
        const open = infoPanel.classList.toggle('is-open');
        infoToggle.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>